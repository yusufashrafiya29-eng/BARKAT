# API Configuration
PROJECT_NAME="Smart Restaurant Software API"
VERSION="1.0.0"

# Supabase Credentials (Obtain from your Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"

# Database Connection
# In Supabase -> Settings -> Database -> Connection string (URI) 
# Note: psycopg2 needs the string starting with postgresql://
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
JWT_SECRET="your-super-secret-jwt-key"
